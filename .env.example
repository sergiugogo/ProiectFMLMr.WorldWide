# OpenAI API key — required for embeddings (at query time) and curriculum generation
OPENAI_API_KEY=sk-...

# Inference backend: "lmstudio" or "ollama"
INFERENCE_BACKEND=lmstudio

# LM Studio — model identifier shown in the Local Server > API tab
LM_STUDIO_MODEL=mrworldwide-deepseek-r1-7b-socratic-fr
LM_STUDIO_BASE_URL=http://localhost:1234/v1

# Ollama — only needed when INFERENCE_BACKEND=ollama
# OLLAMA_MODEL=hf.co/MihaiRusu/mrworldwide-deepseek-r1-7b-socratic-fr:Q4_K_M

# Embedder: "openai" (default, requires API key) or "bge-m3" (local, free)
# EMBEDDER=openai

# ChromaDB storage location
# CHROMA_DIR=./chroma_db

# User state: "sqlite" (default) or "postgres"
# USER_STATE_BACKEND=sqlite
# USER_STATE_DB=./user_state.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/mrworldwide

# Set to 1 to use GPT-4o-mini for query routing instead of the keyword heuristic
# USE_LLM_ROUTER=0

# Number of prior conversation turns replayed to the model
# HISTORY_TURNS=6

# Model used by generate_curriculum.py
GEN_MODEL=gpt-5-mini

# Allowed CORS origins for production (comma-separated). Defaults to * in dev.
# CORS_ORIGINS=https://yourapp.com
